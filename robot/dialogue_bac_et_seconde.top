topic: ~educatee_dialog()
language: frf

# ====================================================================
# TOPIC QICHAT - MÉMOIRE EDUCATEE POUR ROBOT NAO
# Source exclusive : educatee.fr (par Cécile Cathelin)
# ====================================================================

# --- CONCEPTS (SYNONYMES ET MOTS CLÉS RECONNUS PAR NAO) ---
concept:(salutations) [bonjour salut "coucou nao" "bonjour nao" "hey nao" "salut nao"]
concept:(qui_es_tu) ["qui es-tu" "présente-toi" "c'est quoi ta mémoire" "d'où viennent tes cours" "c'est quoi educatée"]
concept:(seconde) [seconde "la seconde" "cours de seconde" "programme de seconde" "l'odyssée du lecteur"]
concept:(pourquoi_bac_seconde) ["pourquoi le bac en seconde" "pourquoi s'entraîner en seconde" "anticiper le bac en seconde" "conseil seconde"]
concept:(bac) [bac "bac de français" "baccalauréat de français" "épreuves du bac" "programme de première" "le coin des premières"]
concept:(commentaire) [commentaire "commentaire littéraire" "méthode du commentaire" "comment faire un commentaire" "to do list commentaire"]
concept:(dissertation) [dissertation "dissertation littéraire" "méthode de la dissertation" "comment faire une dissertation" "phrases magiques"]
concept:(oral) [oral "épreuve orale" "l'oral de français" "comment se passe l'oral" "lecture linéaire" "entretien de l'oral"]
concept:(sarraute) [sarraute "nathalie sarraute" "pour un oui ou pour un non" "théâtre en première"]
concept:(laboetie) ["la boétie" "la boetie" "étienne de la boétie" "servitude volontaire" "le contr'un" "littérature d'idées"]
concept:(rimbaud) [rimbaud "arthur rimbaud" "cahiers de douai" "poésie en première"]
